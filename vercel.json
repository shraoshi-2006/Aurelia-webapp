{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|gif|webp|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/hr-document-template", "destination": "/human-resources/hr-document-template.html" },
    { "source": "/hr-document-template.html", "destination": "/human-resources/hr-document-template.html" },
    { "source": "/hr-document-templates", "destination": "/human-resources/hr-document-template.html" },
    { "source": "/hr-document-templates.html", "destination": "/human-resources/hr-document-template.html" },
    { "source": "/employee-list", "destination": "/human-resources/employee-list.html" },
    { "source": "/employee-list.html", "destination": "/human-resources/employee-list.html" },
    { "source": "/add-employee", "destination": "/human-resources/add-employee.html" },
    { "source": "/add-employee.html", "destination": "/human-resources/add-employee.html" },
    { "source": "/holiday-list", "destination": "/human-resources/holiday-list.html" },
    { "source": "/holiday-list.html", "destination": "/human-resources/holiday-list.html" }
  ]
}
